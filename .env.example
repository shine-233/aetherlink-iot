# Copy this file to .env before running docker compose.
# Keep real passwords and public addresses out of source control.

COMPOSE_PROJECT_NAME=aetherlink-iot

# Deployment performance tier.
# light: default first-device/private trial, keeps the stack light for 1C/2GB.
# standard: normal small production install, starts from about 2C/4GB.
# production: larger private install, starts from about 4C/8GB.
# These are resource presets, not benchmark claims. Keep benchmark evidence in
# verification/performance-* before promising device/message capacity.
AETHERLINK_PERFORMANCE_TIER=light

# Docker Compose resource presets consumed by docker-compose.yml.
# The init scripts rewrite these when AETHERLINK_PERFORMANCE_TIER changes.
AETHERLINK_POSTGRES_CPUS=0.40
AETHERLINK_POSTGRES_MEM_LIMIT=512m
AETHERLINK_REDIS_CPUS=0.20
AETHERLINK_REDIS_MEM_LIMIT=128m
AETHERLINK_MQTT_CPUS=0.30
AETHERLINK_MQTT_MEM_LIMIT=128m
AETHERLINK_BACKEND_CPUS=0.70
AETHERLINK_BACKEND_MEM_LIMIT=768m
AETHERLINK_FRONTEND_CPUS=0.20
AETHERLINK_FRONTEND_MEM_LIMIT=128m

# Public addresses shown to users and generated onboarding commands.
# The localhost defaults are only for local/demo installs. In -Server/--server
# mode they are blocking doctor errors until replaced with a reachable IP/domain.
# AETHERLINK_PUBLIC_URL is the browser address for operators.
# On a real server, replace localhost with the IP/domain that users can open.
AETHERLINK_PUBLIC_URL=http://localhost:8080
# AETHERLINK_MQTT_ACCESS_ADDRESS is the MQTT host:port used by devices.
# On a real server, replace localhost with the IP/domain that devices can reach.
AETHERLINK_MQTT_ACCESS_ADDRESS=localhost:1883
# The init scripts set this to 1 for -Server/--server deployments. In server
# mode the backend /ready endpoint fails closed until both public addresses are
# non-local and valid; keep 0 for local-only development.
AETHERLINK_SERVER_MODE=0

# Container ports exposed on the host. The safe default is loopback-only.
# Local installs keep published ports on loopback. In -Server/--server mode,
# init switches this loopback default to 0.0.0.0 unless -BindAddress/
# --bind-address is supplied; use a trusted interface when possible and apply
# the host firewall policy before exposing the stack to remote operators or
# devices.
AETHERLINK_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
BACKEND_PORT=9999
MQTT_PORT=1883
BROKER_METRICS_PORT=8082

# Database.
POSTGRES_DB=aetherlink_iot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password

# Redis.
REDIS_PASSWORD=change_me_redis_password

# MQTT broker control credentials and stable SW3 acknowledgement identity.
# Each broker replica needs a distinct, stable MQTT_BROKER_ID. The single-node
# Compose deployment uses the value below and passes the same ID to the backend
# as its explicit required acknowledgement set.
MQTT_ROOT_PASSWORD=change_me_mqtt_root_password
MQTT_PLUGIN_PASSWORD=change_me_mqtt_plugin_password
# Optional application-layer shared secret for the broker admin HTTP API.
# When set, every admin HTTP API call must carry a matching X-Admin-Secret
# header. Leave empty to keep the loopback-only default; always set it when
# exposing admin ports beyond 127.0.0.1 in binary (non-Compose) deployments.
MQTT_ADMIN_HTTP_AUTH_SECRET=
MQTT_BROKER_ID=aetherlink-broker-1

# Durable broker persistence (2026-08): Compose defaults to redis so sessions,
# subscriptions, and QoS queues survive broker restarts. Switching to memory
# drops offline sessions and queued messages on every broker restart.
MQTT_PERSISTENCE_TYPE=redis
MQTT_PERSISTENCE_REDIS_DB=2

# Optional local payload-schema enforcement. It reuses PostgreSQL and requires
# migration 46; keep it disabled until reject semantics are deployment-tested.
AETHERLINK_PAYLOAD_SCHEMA_ENABLED=false
AETHERLINK_PAYLOAD_SCHEMA_CACHE_TTL=30s

# Backend secrets and runtime tuning.
GOTP_JWT_KEY=change_me_at_least_32_chars_random_secret
# JWT 有效期（小时）。默认 24；登录和刷新接口会续签 token，调小可缩短泄露窗口。
# GOTP_JWT_EXPIRE_HOURS=24
# x-api-key（OpenAPI Key）等效 claims 的权限。open_api_keys 表没有独立权限字段，
# 所有 API Key 共用该值；2026-08 起默认降为最小权限 TENANT_USER，
# 需要 OpenAPI 写能力的部署必须显式配置为更高角色。
# GOTP_OPENAPI_KEY_AUTHORITY=TENANT_USER
# 登录/刷新成功后是否下发 HttpOnly 认证 cookie（SameSite=Lax; Path=/api/v1）。
# 默认 true；刷新端点同时接受 cookie 或 x-token 头（cookie 优先），关闭后回到纯 header 模式。
# GOTP_AUTH_COOKIE_ENABLED=true
# 认证 cookie 是否带 Secure 标志。默认 false 以兼容本地 HTTP 联调；HTTPS 生产部署应设为 true。
# GOTP_AUTH_COOKIE_SECURE=false
# 协议插件接入端点(/api/v1/plugin/*)共享密钥。留空时仅放行回环/私网来源（公网来源 401）；
# 配置后所有来源必须携带 X-Plugin-Key 请求头。生产部署建议生成 32 位以上随机值。
GOTP_PLUGIN_SERVICE_KEY=
# 公开 WebSocket 端点每来源 IP 并发连接上限。默认 64；公网部署可按客户端规模下调。
# GOTP_WS_MAX_CONNS_PER_IP=64
GOTP_LOG_LEVEL=info
GOTP_SERVICE_HTTP_HOST=0.0.0.0
GOTP_SERVICE_HTTP_PORT=9999

# Private durable-spool capacity and replay tuning. Compose fixes each spool to
# its own non-public persistent volume; these values tune logical limits and
# retry cadence only. Confirm real disk/inode headroom before increasing them.
AETHERLINK_TELEMETRY_SPOOL_MAX_BYTES=536870912
AETHERLINK_TELEMETRY_SPOOL_MAX_RECORDS=100000
AETHERLINK_TELEMETRY_SPOOL_MAX_RECORD_BYTES=16777216
AETHERLINK_TELEMETRY_SPOOL_REPLAY_INTERVAL=30s
AETHERLINK_TELEMETRY_SPOOL_REPLAY_BATCH_SIZE=100
AETHERLINK_TELEMETRY_SPOOL_REPLAY_TIMEOUT=10s
AETHERLINK_ATTRIBUTE_EVENT_SPOOL_MAX_BYTES=536870912
AETHERLINK_ATTRIBUTE_EVENT_SPOOL_MAX_RECORDS=100000
AETHERLINK_ATTRIBUTE_EVENT_SPOOL_MAX_RECORD_BYTES=16777216
AETHERLINK_ATTRIBUTE_EVENT_SPOOL_REPLAY_INTERVAL=30s
AETHERLINK_ATTRIBUTE_EVENT_SPOOL_REPLAY_BATCH_SIZE=100
AETHERLINK_ATTRIBUTE_EVENT_SPOOL_REPLAY_TIMEOUT=10s

# Backend dependency addresses inside the Docker network.
GOTP_DB_PSQL_HOST=postgres
GOTP_DB_PSQL_PORT=5432
GOTP_DB_PSQL_DBNAME=aetherlink_iot
GOTP_DB_PSQL_USERNAME=postgres
GOTP_DB_PSQL_PASSWORD=change_me_postgres_password
GOTP_DB_REDIS_ADDR=redis:6379
GOTP_DB_REDIS_DB=1
GOTP_DB_REDIS_DB1=10
GOTP_DB_REDIS_PASSWORD=change_me_redis_password
GOTP_MQTT_SERVER=gmqtt
GOTP_MQTT_BROKER=mqtt-broker:1883
GOTP_MQTT_USER=root
GOTP_MQTT_PASS=change_me_mqtt_root_password
# These two backend-generated public addresses must match the operator/device
# addresses above. The init scripts keep them in sync when -PublicUrl/
# --public-url and -MqttAddress/--mqtt-address are used. If you edit .env by
# hand, update both pairs together and run the doctor again.
GOTP_MQTT_ACCESS_ADDRESS=localhost:1883
GOTP_OTA_DOWNLOAD_ADDRESS=http://localhost:8080
