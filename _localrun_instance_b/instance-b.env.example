# Public template for an isolated local validation instance B.
# Copy to an ignored local env file and replace CHANGE_ME_* values at runtime.
# Do not commit real credentials, tokens, or database passwords.

API_BASE_URL=http://127.0.0.1:10099/api/v1
HEALTH_URL=http://127.0.0.1:10099/health
API_TARGET=http://127.0.0.1:10099
FRONTEND_URL=http://127.0.0.1:19725
PREVIEW_URL=http://127.0.0.1:19725
PREVIEW_PORT=19725

PLAYWRIGHT_USE_PREVIEW_PROXY=1
PLAYWRIGHT_REUSE_EXISTING_SERVER=0
PREFLIGHT_PROFILE=full

# Keep this instance's outputs separate from shared automation state.
AUTOMATION_REPORT_DIR=./_localrun_instance_b/reports
AUTOMATION_VERIFICATION_DIR=./_localrun_instance_b/verification
E2E_AUTH_DIR=./_localrun_instance_b/auth
AUTOMATION_ACCOUNT_DIR=./_localrun_instance_b/accounts

# The synthetic lane requires an explicit database allowlist and opt-in.
# These are placeholders, not database credentials.
AETHERLINK_RDI_FIXTURE_MODE=synthetic-rdi
AETHERLINK_RDI_FIXTURE_PID=SYNTHRDI0001
SYNTHETIC_RDI_PID=SYNTHRDI0001
AETHERLINK_SYNTHETIC_RDI_ALLOWED_DATABASES=CHANGE_ME_ISOLATED_DATABASE
AETHERLINK_SYNTHETIC_RDI_ALLOW=1

SUPER_ADMIN_EMAIL=CHANGE_ME_SUPER_ADMIN_EMAIL
SUPER_ADMIN_PASSWORD=CHANGE_ME_SUPER_ADMIN_PASSWORD
TENANT_ADMIN_EMAIL=CHANGE_ME_TENANT_ADMIN_EMAIL
TENANT_ADMIN_PASSWORD=CHANGE_ME_TENANT_ADMIN_PASSWORD
TENANT_ADMIN_B_EMAIL=CHANGE_ME_TENANT_ADMIN_B_EMAIL
TENANT_ADMIN_B_PASSWORD=CHANGE_ME_TENANT_ADMIN_B_PASSWORD
TENANT_USER_EMAIL=CHANGE_ME_TENANT_USER_EMAIL
TENANT_USER_PASSWORD=CHANGE_ME_TENANT_USER_PASSWORD
READONLY_USER_EMAIL=CHANGE_ME_READONLY_USER_EMAIL
READONLY_USER_PASSWORD=CHANGE_ME_READONLY_USER_PASSWORD
EMAIL_CHANGE_TENANT_EMAIL=CHANGE_ME_EMAIL_CHANGE_TENANT_EMAIL
EMAIL_CHANGE_TENANT_PASSWORD=CHANGE_ME_EMAIL_CHANGE_TENANT_PASSWORD
