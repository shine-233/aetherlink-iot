# Local release-style automation env example.
# Copy values into an ignored local env file or into your current shell.

API_BASE_URL=http://127.0.0.1:9999/api/v1
FRONTEND_URL=http://127.0.0.1:9725
PREVIEW_URL=http://127.0.0.1:9725
API_TARGET=http://127.0.0.1:9999

# Hosted integration uses the explicit generic-emulator lane.  A real
# physical RDI device is not inferred from these values and is not covered by
# this workflow; it needs a separately authorized device runner.
AETHERLINK_DEVICE_VALIDATION_MODE=generic-emulator
AETHERLINK_MQTT_ACCESS_ADDRESS=127.0.0.1:1883
AUTOMATION_READY_CHECK_DEVICE_ID=
AUTOMATION_READY_CHECK_AUTO_START=true

# MQTT endpoint used by the automation harness. Standard deployments and the
# backend local-dev config use 127.0.0.1:1883. If the backend process exports
# GOTP_MQTT_ACCESS_ADDRESS or AETHERLINK_MQTT_ACCESS_ADDRESS, the harness
# follows that address unless an explicit AUTOMATION_MQTT_SERVER/PORT override
# is supplied.
#
# The isolated localdev-status broker on 127.0.0.1:1885 is opt-in only:
# AUTOMATION_MQTT_PROFILE=localdev-status
# AUTOMATION_MQTT_SERVER=127.0.0.1
# AUTOMATION_MQTT_PORT=1885

# `full` is the release gate and requires every account below. `local-lite`
# skips only account checks and must not be used as release evidence.
PREFLIGHT_PROFILE=full
PREVIEW_PORT=9725
PREFLIGHT_HTTP_TIMEOUT_MS=5000

PLAYWRIGHT_USE_PREVIEW_PROXY=1
PLAYWRIGHT_REUSE_EXISTING_SERVER=0
PLAYWRIGHT_BROWSER_CHANNEL=chromium
# PLAYWRIGHT_BROWSER_EXECUTABLE_PATH=

# Optional paths for a concurrent local validation instance. Keep every path
# outside the shared automation_tests/reports, e2e/.auth, and .local folders.
# AUTOMATION_REPORT_DIR=C:/path/to/aetherlink-instance/reports
# AUTOMATION_VERIFICATION_DIR=C:/path/to/aetherlink-instance/verification
# E2E_AUTH_DIR=C:/path/to/aetherlink-instance/auth
# AUTOMATION_ACCOUNT_DIR=C:/path/to/aetherlink-instance/accounts

SUPER_ADMIN_EMAIL=CHANGE_ME_SUPER_ADMIN_EMAIL
SUPER_ADMIN_PASSWORD=CHANGE_ME_SUPER_ADMIN_PASSWORD
TENANT_ADMIN_EMAIL=CHANGE_ME_TENANT_ADMIN_EMAIL
TENANT_ADMIN_PASSWORD=CHANGE_ME_TENANT_ADMIN_PASSWORD
TENANT_ADMIN_B_EMAIL=CHANGE_ME_TENANT_ADMIN_B_EMAIL
TENANT_ADMIN_B_PASSWORD=CHANGE_ME_TENANT_ADMIN_B_PASSWORD
TENANT_USER_EMAIL=CHANGE_ME_TENANT_USER_EMAIL
TENANT_USER_PASSWORD=CHANGE_ME_TENANT_USER_PASSWORD
READONLY_USER_EMAIL=CHANGE_ME_READONLY_USER_EMAIL
READONLY_USER_PASSWORD=CHANGE_ME_READONLY_USER_PASSWORD
EMAIL_CHANGE_TENANT_EMAIL=CHANGE_ME_EMAIL_CHANGE_TENANT_EMAIL
EMAIL_CHANGE_TENANT_PASSWORD=CHANGE_ME_EMAIL_CHANGE_TENANT_PASSWORD
