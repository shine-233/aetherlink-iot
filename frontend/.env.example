# Public, non-secret frontend build defaults.
# Copy to .env.local for local customization; do not put credentials here.
VITE_BASE_URL=/
VITE_APP_TITLE=AetherLink IoT
VITE_APP_DESC=AetherLink IoT platform
VITE_ROUTER_HISTORY_MODE=history
VITE_ICON_PREFIX=icon
VITE_ICON_LOCAL_PREFIX=local-icon
VITE_HTTP_PROXY=N
VITE_SERVICE_ENV=prod
VITE_AUTH_ROUTE_MODE=dynamic
VITE_ROUTE_HOME=dashboard_workbench
VITE_MENU_ICON=mdi:menu
VITE_ENABLE_THINGSVIS_COMPAT=N

# Optional integrations remain disabled unless explicitly configured.
VITE_ENABLE_REMOTE_VERSION_CHECK=N
VITE_BAIDU_MAP_KEY=
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
VITE_TENCENT_MAP_KEY=
VITE_THINGSVIS_STUDIO_URL=
VITE_THINGSVIS_API_URL=
