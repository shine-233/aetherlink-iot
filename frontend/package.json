{
  "name": "aetherlink-frontend",
  "type": "module",
  "version": "1.1.9",
  "description": "AetherLink IoT frontend",
  "author": {
    "name": "AetherLink"
  },
  "license": "Apache-2.0",
  "keywords": [
    "AetherLink IoT",
    "AetherLink",
    "IoT"
  ],
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 VITE_SERVICE_ENV=prod vite build",
    "build:check": "pnpm run typecheck && pnpm run typecheck:data-architecture && pnpm run typecheck:packages && pnpm run typecheck:blindspots && pnpm run build",
    "build:8192": "cross-env NODE_OPTIONS=--max-old-space-size=8192 VITE_SERVICE_ENV=prod vite build",
    "build:test": "cross-env VITE_SERVICE_ENV=test vite build",
    "build:vite": "cross-env NODE_OPTIONS=--max-old-space-size=4096 VITE_SERVICE_ENV=prod vite build",
    "build:lite": "cross-env NODE_OPTIONS=--max-old-space-size=4096 VITE_SERVICE_ENV=prod VITE_LIGHT_BUILD=Y vite build --outDir dist-lite",
    "build:vercel": "cross-env VITE_HASH_ROUTE=Y VITE_VERCEL=Y vite build",
    "cleanup": "aetherlink cleanup",
    "commit": "aetherlink git-commit",
    "dev": "cross-env VITE_SERVICE_ENV=dev vite",
    "dev:skip-router-gen": "cross-env AETHERLINK_SKIP_ELEGANT_ROUTER=1 VITE_SERVICE_ENV=dev vite",
    "dev:prod": "cross-env VITE_SERVICE_ENV=prod vite",
    "dev:test": "cross-env VITE_SERVICE_ENV=test vite",
    "format": "prettier --write .",
    "gen-route": "aetherlink gen-route",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "preview": "vite preview",
    "release": "aetherlink release",
    "start": "cross-env VITE_SERVICE_ENV=dev vite",
    "tsx": "tsx",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vue-tsc --noEmit --skipLibCheck",
    "typecheck:data-architecture": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc --project tsconfig.data-architecture.json --noEmit --skipLibCheck",
    "typecheck:packages": "node scripts/typecheck-workspaces.mjs",
    "typecheck:blindspots": "node scripts/typecheck-blindspots.mjs",
    "update-pkg": "aetherlink update-pkg",
    "quality-check": "node scripts/dev-quality-check.js",
    "audit:grid-drag": "node scripts/audit-grid-drag-deps.js",
    "pre-commit-check": "pnpm run quality-check",
    "clean-console": "node scripts/remove-console-logs.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "pnpm run test:coverage:frontend",
    "test:coverage:frontend": "vitest run --coverage --maxWorkers=1 --minWorkers=1 --no-file-parallelism",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@aetherlink/axios": "workspace:*",
    "@aetherlink/color-palette": "workspace:*",
    "@aetherlink/hooks": "workspace:*",
    "@aetherlink/materials": "workspace:*",
    "@aetherlink/utils": "workspace:*",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@iconify/vue": "5.0.1",
    "@tresjs/cientos": "^5.8.1",
    "@tresjs/core": "^5.8.3",
    "@vueuse/core": "14.4.0",
    "axios": "1.19.0",
    "codemirror": "6.0.2",
    "dayjs": "1.11.21",
    "echarts": "^6.1.0",
    "grid-layout-plus": "^1.1.1",
    "highlight.js": "^11.12.0",
    "lodash-es": "4.18.1",
    "motion-v": "^2.4.0",
    "naive-ui": "2.44.1",
    "nanoid": "5.1.16",
    "node-forge": "^1.3.1",
    "nprogress": "0.2.0",
    "pinia": "^3.0.3",
    "three": "^0.185.1",
    "vue": "^3.5.41",
    "vue-codemirror6": "^1.6.1",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.4.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@aetherlink/scripts": "workspace:*",
    "@aetherlink/uno-preset": "workspace:*",
    "@amap/amap-jsapi-types": "0.0.15",
    "@elegant-router/vue": "0.3.8",
    "@eslint/js": "^9.39.5",
    "@iconify-json/ant-design": "^1.2.8",
    "@iconify-json/ic": "^1.2.2",
    "@iconify-json/material-symbols": "^1.2.88",
    "@iconify-json/mdi": "^1.2.3",
    "@tresjs/cientos": "^5.8.1",
    "@tresjs/core": "^5.8.3",
    "@types/bmapgl": "0.0.7",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.2.0",
    "@types/node-forge": "^1.3.11",
    "@types/nprogress": "0.2.3",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@unocss/preset-uno": "66.7.5",
    "@unocss/transformer-directives": "66.7.5",
    "@unocss/transformer-variant-group": "66.7.5",
    "@unocss/vite": "66.7.5",
    "@vicons/ionicons5": "^0.13.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "@vue-flow/core": "^1.48.2",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "10.1.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "10.10.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "7.1.1",
    "sass": "1.102.0",
    "three": "^0.185.1",
    "tsx": "4.23.12",
    "typescript": "^5.5.2",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "0.26.0",
    "vite": "^6.4.3",
    "vite-plugin-progress": "0.0.7",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@10.8.0+sha512.0e82714d1b5b43c74610193cb20734897c1d00de89d0e18420aebc5977fa13d780a9cb05734624e81ebd81cc876cd464794850641c48b9544326b5622ca29971",
  "pnpm": {
    "overrides": {
      "follow-redirects": "1.16.0",
      "form-data": "4.0.6",
      "ajv": "6.14.0",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "braces@2": "3.0.3",
      "defu": "6.1.7",
      "esbuild": "0.27.0",
      "flatted": "3.4.2",
      "glob@7": "10.5.0",
      "glob@10": "10.5.0",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.1",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "minimatch@3": "3.1.4",
      "minimatch@5": "5.1.8",
      "minimatch@9": "9.0.9",
      "micromatch@3": "4.0.8",
      "micromatch@4": "4.0.8",
      "postcss": "8.5.23",
      "picomatch": "2.3.2",
      "qs": "6.15.3",
      "rollup@2": "2.80.0",
      "rollup@4": "4.62.4",
      "svgo@2": "2.8.3",
      "svgo@3": "3.3.4",
      "tar": "7.5.21",
      "@tootallnate/once": "2.0.1"
    }
  }
}
