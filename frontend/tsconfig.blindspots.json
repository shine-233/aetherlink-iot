{
  "extends": "./tsconfig.json",
  "include": ["./src/**/*.ts", "./src/**/*.tsx", "./src/**/*.vue", "./env.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "packages",
    "src/__tests__",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/examples/**",
    "**/backup/**",
    "**/*_backup_*/**",
    "**/* copy.vue"
  ]
}
