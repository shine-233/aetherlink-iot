{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "tsBuildInfoFile": null,
    "noEmit": true
  },
  "include": [
    "./src/typings/**/*.d.ts",
    "./src/core/data-architecture/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/examples/**",
    "**/backup/**",
    "**/*_backup_*/**"
  ]
}
